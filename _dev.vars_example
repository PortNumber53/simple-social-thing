# Cloudflare Worker / Vite local dev vars example
# Copy to `frontend/.dev.vars` for wrangler dev, or merge into your existing `.dev.vars`.
# These values are read by `frontend/worker/index.ts` and Vite (VITE_*).

# --- Google OAuth (Worker-side, used by YouTube integration) ---
# Google login OAuth is now handled by the Go backend (see backend/.env).
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# --- Instagram OAuth (Worker-side) ---
INSTAGRAM_APP_ID=your_instagram_app_id_here
INSTAGRAM_APP_SECRET=your_instagram_app_secret_here

# --- TikTok OAuth (Worker-side) ---
# Callback URL must be exact and registered in TikTok developer console:
# - Local dev:  http://localhost:18912/api/integrations/tiktok/callback
# - Production: https://<your-domain>/api/integrations/tiktok/callback
TIKTOK_CLIENT_KEY=your_tiktok_client_key_here
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret_here

# --- Pinterest OAuth (Worker-side) ---
# Callback URL must be exact and registered:
# - Local dev:  http://localhost:18912/api/integrations/pinterest/callback
# - Production: https://<your-domain>/api/integrations/pinterest/callback
PINTEREST_CLIENT_ID=your_pinterest_client_id_here
PINTEREST_CLIENT_SECRET=your_pinterest_client_secret_here

# --- Suno integration (Worker-side) ---
# Suno API keys are stored per-user in the database (`UserSettings`) via the Integrations UI.
# No Suno secrets should be placed in `.dev.vars` / Wrangler secrets.

# --- Backend origin override (optional) ---
# Used by worker to call Go backend directly in local dev.
BACKEND_URL=http://localhost:18911

# --- Frontend build vars (Vite) ---
VITE_WORKER_ORIGIN=http://localhost:18912
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here
VITE_BACKEND_URL=http://localhost:18911
VITE_DISABLE_CF_PLUGIN=1

# --- Local dev switches ---
# Set true to bypass real OAuth when running locally.
USE_MOCK_AUTH=false
