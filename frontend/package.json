{
	"name": "frontend",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "rm -rf node_modules/.vite && wrangler types && concurrently -n client,worker -c green,cyan \"npm:dev:client\" \"npm:dev:worker\"",
		"dev:client": "VITE_DISABLE_CF_PLUGIN=1 vite",
		"dev:worker": "bash -c 'set -a && source .dev.vars && CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=$DATABASE_URL wrangler dev --local --ip 0.0.0.0 --port 18912 --config wrangler.dev.jsonc'",
		"build": "tsc -b && vite build",
		"lint": "eslint .",
		"test": "NODE_NO_WARNINGS=1 vitest run",
		"test:watch": "NODE_NO_WARNINGS=1 vitest",
		"test:coverage": "NODE_NO_WARNINGS=1 vitest run --coverage",
		"preview": "npm run build && vite preview",
		"deploy": "npm run build && wrangler deploy --config wrangler.jsonc",
		"cf-typegen": "wrangler types --config wrangler.jsonc"
	},
	"dependencies": {
		"@google-cloud/local-auth": "^3.0.1",
		"@stripe/stripe-js": "^8.6.1",
		"react": "^19.1.1",
		"react-dom": "^19.1.1",
		"react-resizable-panels": "^2.1.3",
		"react-router-dom": "^7.18.2"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.13.13",
		"@eslint/js": "^9.33.0",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.0",
		"@testing-library/user-event": "^14.6.1",
		"@types/node": "^24.8.1",
		"@types/react": "^19.1.10",
		"@types/react-dom": "^19.1.7",
		"@vitejs/plugin-react-swc": "^4.0.0",
		"@vitest/coverage-v8": "^3.2.6",
		"autoprefixer": "^10.4.21",
		"concurrently": "^9.2.1",
		"eslint": "^9.33.0",
		"eslint-plugin-react-hooks": "^5.2.0",
		"eslint-plugin-react-refresh": "^0.4.20",
		"globals": "^16.3.0",
		"happy-dom": "^20.8.9",
		"jsdom": "^26.1.0",
		"postcss": "^8.5.23",
		"tailwindcss": "^3.4.18",
		"typescript": "~5.8.3",
		"typescript-eslint": "^8.39.1",
		"vite": "^7.3.5",
		"vitest": "^3.2.6",
		"wrangler": "^4.59.1"
	},
	"overrides": {
		"undici": "7.29.0",
		"sharp": "0.35.0",
		"shell-quote": "1.9.0",
		"js-yaml": "4.3.1",
		"brace-expansion": "2.1.2",
		"ws": "8.21.0",
		"uuid": "11.1.1",
		"defu": "6.1.5",
		"picomatch": "4.0.4",
		"flatted": "3.4.2",
		"minimatch": "9.0.7",
		"rollup": "4.59.0",
		"jws": "4.0.1",
		"glob": "10.5.0",
		"esbuild": "0.25.0",
		"wrangler": "$wrangler"
	}
}
