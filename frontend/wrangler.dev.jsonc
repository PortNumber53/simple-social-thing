/**
 * Development configuration for Wrangler
 * This config is used for local development only
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "social-manager-thing-frontend-dev",
	"main": "worker/index.ts",
	"compatibility_date": "2025-01-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true
	}
}
